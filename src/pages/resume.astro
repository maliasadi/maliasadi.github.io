---
import Base from '../layouts/Base.astro';

const description =
  'Resume of Ali Asadi, performance tech lead and senior quantum software developer at Xanadu in Toronto.';
---

<Base title="Resume" description={description}>
  <div class="wrap resume">
    <header class="page-hero">
      <p class="kicker"><span class="dot" aria-hidden="true"></span>Experience</p>
      <h1>Resume</h1>
      <p class="lead">
        Performance tech lead and senior quantum software developer at Xanadu, Toronto.
      </p>
      <p class="lead-link">
        <a href="/ali-asadi-cv.pdf">Download PDF</a>
        <a href="https://github.com/maliasadi">GitHub</a>
        <a href="https://linkedin.com/in/maliasadi">LinkedIn</a>
        <a href="https://pennylane.ai/profile/maliasadi">PennyLane</a>
        <a href="https://scholar.google.ca/citations?user=pUKiEEoAAAAJ">Publications</a>
      </p>
    </header>

    <section aria-labelledby="experience">
      <h2 id="experience">Experience</h2>

      <article class="role">
        <div class="role-head">
          <h3>Xanadu Quantum Technologies</h3>
          <p class="entry-date">Sept 2021 – Present</p>
        </div>
        <p class="role-title">Performance Tech Lead and Sr. Quantum Software Developer · Toronto</p>
        <ul>
          <li>
            Built PennyLane Lightning and Lightning GPU, open-source C++17/20 state-vector quantum
            simulators with AVX, OpenMP, MPI, and GPU support.
          </li>
          <li>
            Introduced distributed state-vector simulation in PennyLane, extended the Python bindings,
            sanitizers, and packaging, and improved how PennyLane and Lightning scale on HPC workstations.
          </li>
          <li>
            Contributed to PennyLane Catalyst, an end-to-end JIT compiler and runtime for simulators and
            quantum hardware, built on QIR, LLVM/MLIR, and JAX.
          </li>
          <li>
            Led Catalyst Runtime: an extensible, thread-safe, multi-device QIR and QASM runtime with async
            execution and dynamic device plugins.
          </li>
          <li>
            As performance tech lead, I help the software team speed up PennyLane, Lightning, and Catalyst,
            develop new simulators, and keep hybrid quantum machine-learning workflows fast on JAX, Autograd,
            TensorFlow, and PyTorch.
          </li>
        </ul>
      </article>

      <article class="role">
        <div class="role-head">
          <h3>Western University</h3>
          <p class="entry-date">Sept 2017 – Sept 2021</p>
        </div>
        <p class="role-title">Research Assistant · London, Canada</p>
        <ul>
          <li>
            Ph.D. thesis on a fast symbolic system solver based on RegularChain, written in C and C++17 and
            packaged in BPASLib.
          </li>
          <li>
            Led algorithms for dense polynomial arithmetic over prime fields and big integers, including
            cache-friendly parallel arithmetic for dense and sparse multivariate polynomials, and the
            high-performance BPAS solver.
          </li>
        </ul>
      </article>

      <article class="role">
        <div class="role-head">
          <h3>Maplesoft</h3>
          <p class="entry-date">June 2020 – Sept 2020</p>
        </div>
        <p class="role-title">R&amp;D Software Developer Intern · Waterloo, Canada</p>
        <ul>
          <li>Contributed to the multivariate power series library in Maple 2021.</li>
          <li>Sped up basic arithmetic enough to improve factorization by up to 500×.</li>
        </ul>
      </article>
    </section>

    <section aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ul class="edu">
        <li>
          <div class="role-head">
            <h3>Ph.D. in Computer Science</h3>
            <p class="entry-date">2017 – 2021</p>
          </div>
          <p class="role-title">Western University · HPC in scientific computing</p>
        </li>
        <li>
          <div class="role-head">
            <h3>M.Sc. in Computer Science</h3>
            <p class="entry-date">2014 – 2017</p>
          </div>
          <p class="role-title">Isfahan University of Technology · Cryptography and coding theory</p>
        </li>
        <li>
          <div class="role-head">
            <h3>B.Sc. in Mathematics</h3>
            <p class="entry-date">2010 – 2014</p>
          </div>
          <p class="role-title">Isfahan University of Technology · Computational and applied mathematics</p>
        </li>
      </ul>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <div class="skill-group">
        <h3>Languages</h3>
        <ul class="tags">
          <li><span>C</span></li>
          <li><span>C++</span></li>
          <li><span>Python</span></li>
          <li><span>Rust</span></li>
          <li><span>Mojo</span></li>
        </ul>
        <p class="hint">Rust and Mojo are familiar, not primary.</p>
      </div>
      <div class="skill-group">
        <h3>HPC</h3>
        <ul class="tags">
          <li><span>AVX</span></li>
          <li><span>OpenMP</span></li>
          <li><span>Kokkos</span></li>
          <li><span>CUDA</span></li>
          <li><span>HIP</span></li>
          <li><span>MPI</span></li>
          <li><span>Dask</span></li>
          <li><span>Ray</span></li>
        </ul>
      </div>
      <p>Scientific software, debugging, profiling, runtimes, and compilers.</p>
    </section>

    <section aria-labelledby="awards">
      <h2 id="awards">Awards</h2>
      <ul class="awards">
        <li>Mitacs Research and Development Scholarship for the Maplesoft internship, 2020</li>
        <li>Western Graduate Research Scholarship for the Ph.D. in Computer Science, 2017</li>
        <li>Ranked first among the M.Sc. students of the 2014 class in the department</li>
        <li>Ranked first among the B.Sc. students of the 2010 class in the department</li>
        <li>Ranked first in the Mathematics and Computing University Competition, 2011</li>
      </ul>
    </section>
  </div>
</Base>
