---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap article">
    <header>
      <p class="kicker">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      </p>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <ul class="tags">
        {
          post.data.sample && (
            <li>
              <span>Sample</span>
            </li>
          )
        }
        {
          post.data.tags.map((tag) => (
            <li>
              <span>{tag}</span>
            </li>
          ))
        }
      </ul>
      {
        post.data.sample && (
          <p class="sample-note">
            Sample post, here so the theme, code highlighting, and equations can be reviewed. Delete
            <code>src/content/blog/{post.id}.md</code> when you publish your own writing.
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
