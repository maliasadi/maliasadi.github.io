---
import { Image } from 'astro:assets';
import aliPhoto from '../assets/ali.jpg';
import { storyCopy as c } from '../lib/storyCopy';
import Bloch from './Bloch.astro';
import ClusterRacks from './ClusterRacks.astro';

const gold = '#E8B04B';
const cyan = '#4FD1E8';
const sand = '#D9A878';
const green = '#3FB950';
---

<div class="progress-sync" aria-hidden="true"></div>

<nav class="story-bar" aria-label="Story stages">
  <ol>
    <li>
      <button type="button" data-stage="intro">
        <span class="story-dot" aria-hidden="true"></span>
        <span class="story-label">Intro</span>
      </button>
    </li>
    <li>
      <button type="button" data-stage="ch1">
        <span class="story-dot" aria-hidden="true"></span>
        <span class="story-label"><span class="num">01</span> Separate wires</span>
      </button>
    </li>
    <li>
      <button type="button" data-stage="ch2">
        <span class="story-dot" aria-hidden="true"></span>
        <span class="story-label"><span class="num">02</span> Ph.D.</span>
      </button>
    </li>
    <li>
      <button type="button" data-stage="ch3">
        <span class="story-dot" aria-hidden="true"></span>
        <span class="story-label"><span class="num">03</span> Quantum + HPC</span>
      </button>
    </li>
    <li>
      <button type="button" data-stage="ch4">
        <span class="story-dot" aria-hidden="true"></span>
        <span class="story-label"><span class="num">04</span> Supercomputers</span>
      </button>
    </li>
    <li>
      <button type="button" data-stage="ch5">
        <span class="story-dot" aria-hidden="true"></span>
        <span class="story-label"><span class="num">05</span> Lead</span>
      </button>
    </li>
  </ol>
</nav>


<section class="intro" id="intro">
  <div class="intro-top">
    <div class="intro-copy">
      <h1>Ali Asadi</h1>
      <p class="sub">{c.heroTagline}</p>
      <p class="scroll-cue">Scroll <span>↓</span></p>
    </div>
    <Image class="hero-photo" src={aliPhoto} alt="Ali Asadi" width={272} height={272} densities={[1, 2]} />
  </div>
  <div class="stage">
    <svg viewBox="0 0 800 180" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <text x="8" y="58" font-size="20" fill={gold}>|science⟩</text>
      <text x="8" y="138" font-size="20" fill={cyan}>|software⟩</text>
      <line class="intro-gold-glow" x1="160" y1="54" x2="220" y2="54" stroke={gold} stroke-width="7" stroke-linecap="round" opacity="0.25"></line>
      <line class="intro-cyan-glow" x1="160" y1="134" x2="180" y2="134" stroke={cyan} stroke-width="7" stroke-linecap="round" opacity="0.25"></line>
      <line class="intro-gold" x1="160" y1="54" x2="220" y2="54" stroke={gold} stroke-width="2.4"></line>
      <line class="intro-cyan" x1="160" y1="134" x2="180" y2="134" stroke={cyan} stroke-width="2.4"></line>
    </svg>
  </div>
</section>

<section class="chapter" id="ch1">
  <p class="kicker">{c.ch1.kicker}</p>
  <h2>{c.ch1.title}</h2>
  <p class="sub">{c.ch1.subPrefix} <span class="math">{c.ch1.sub}</span></p>
  <ul class="achievements">
    {c.ch1.achievements.map((item) => <li>{item}</li>)}
  </ul>
  <div class="stage">
    <svg viewBox="0 0 840 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Science takes a Hadamard while software stays in ket 0, with a Bloch arrow at ket 0. Midway, a leadership wire appears in ket 0 with its own ket-0 arrow, then a CNOT from science onto leadership entangles those two wires and shrinks their arrows; the software arrow stays full length at ket 0.">
      <defs>
        <radialGradient id="aura-grad-1" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={sand} stop-opacity="0.32"></stop>
          <stop offset="55%" stop-color={gold} stop-opacity="0.16"></stop>
          <stop offset="100%" stop-color={gold} stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <text x="6" y="50" font-size="15" fill={gold}>|science⟩</text>
      <text x="6" y="154" font-size="15" fill={cyan}>|software⟩</text>
      <text class="ch1-lead-label" x="6" y="258" font-size="15" fill={sand}>|leadership⟩</text>
      <text class="ch1-sci-ket" x="148" y="50" font-size="15" fill={gold}>|0⟩</text>
      <text class="ch1-sw-ket" x="148" y="154" font-size="15" fill={cyan}>|0⟩</text>
      <text class="ch1-lead-ket" x="148" y="258" font-size="15" fill={sand}>|0⟩</text>

      <line class="ch1-wire ch1-wire-early wire-glow-gold" x1="184" y1="46" x2="620" y2="46"></line>
      <line class="ch1-wire ch1-wire-early wire-glow-cyan" x1="184" y1="150" x2="620" y2="150"></line>
      <line class="ch1-wire ch1-wire-lead wire-glow-sand" x1="184" y1="254" x2="620" y2="254"></line>
      <line class="ch1-wire ch1-wire-early wire-gold" x1="184" y1="46" x2="620" y2="46" stroke-width="2.4"></line>
      <line class="ch1-wire ch1-wire-early wire-cyan" x1="184" y1="150" x2="620" y2="150" stroke-width="2.4"></line>
      <line class="ch1-wire ch1-wire-lead wire-sand" x1="184" y1="254" x2="620" y2="254" stroke-width="2.4"></line>

      <g class="ch1-gate ch1-gate-h" transform="translate(250,46)">
        <rect class="gate-box" x="-18" y="-16" width="36" height="32" rx="3" stroke={gold} stroke-width="1.4"></rect>
        <text text-anchor="middle" y="5" font-size="14" fill={gold}>H</text>
      </g>

      <Bloch class="bloch-sci" color={gold} x={340} y={46} dir="right" r={26} arrowClass="arrow arrow-sci" />
      <Bloch class="bloch-sw" color={cyan} x={340} y={150} dir="up" r={26} arrowClass="arrow arrow-sw" />
      <Bloch class="bloch-lead" color={sand} x={340} y={254} dir="up" r={26} arrowClass="arrow arrow-lead" />

      <g class="ch1-cnot">
        <line x1="440" y1="46" x2="440" y2="254" stroke={gold} stroke-width="1.6"></line>
        <circle cx="440" cy="46" r="6.5" fill={gold}></circle>
        <circle cx="440" cy="254" r="13" fill="none" stroke={sand} stroke-width="2"></circle>
        <line x1="440" y1="242" x2="440" y2="266" stroke={sand} stroke-width="2"></line>
        <line x1="428" y1="254" x2="452" y2="254" stroke={sand} stroke-width="2"></line>
      </g>

      <ellipse class="ch1-aura" cx="530" cy="150" rx="88" ry="130" fill="url(#aura-grad-1)" stroke="none"></ellipse>

      <g class="ch1-state">
        <text x="630" y="86" font-size="14" fill="#f2f4f8">{c.ch1.stateBell}</text>
        <text x="630" y="106" font-size="11" fill="#c5c9d3">{c.ch1.stateBellOn}</text>
        <text x="630" y="156" font-size="14" fill={cyan}>{c.ch1.softwareIdle}</text>
      </g>
    </svg>
  </div>
  <div class="caption-swap">
    <p class="caption ch1-caption-early"><em>{c.ch1.captionEarly}</em></p>
    <p class="caption ch1-caption-late"><em>{c.ch1.captionLate}</em></p>
  </div>
</section>

<div class="divider" aria-hidden="true"></div>

<section class="chapter" id="ch2">
  <p class="kicker">{c.ch2.kicker}</p>
  <h2>{c.ch2.title}</h2>
  <p class="sub">{c.ch2.sub}</p>
  <ul class="achievements">
    {c.ch2.achievements.map((item) => <li>{item}</li>)}
  </ul>
  <div class="stage">
    <svg class="ch2-continue" viewBox="0 0 840 90" preserveAspectRatio="xMidYMid meet" role="img" aria-label="The three wires continue with no new gates. Science and leadership stay entangled with arrows at the centre; the software arrow stays full length at ket 0.">
      <text x="6" y="18" font-size="12" fill={gold}>|science⟩</text>
      <text x="6" y="48" font-size="12" fill={cyan}>|software⟩</text>
      <text x="6" y="78" font-size="12" fill={sand}>|leadership⟩</text>
      <line class="wire-glow-gold" x1="130" y1="14" x2="520" y2="14"></line>
      <line class="wire-glow-cyan" x1="130" y1="44" x2="520" y2="44"></line>
      <line class="wire-glow-sand" x1="130" y1="74" x2="520" y2="74"></line>
      <line class="wire-gold" x1="130" y1="14" x2="520" y2="14" stroke-width="2.2"></line>
      <line class="wire-cyan" x1="130" y1="44" x2="520" y2="44" stroke-width="2.2"></line>
      <line class="wire-sand" x1="130" y1="74" x2="520" y2="74" stroke-width="2.2"></line>
      <Bloch class="bloch-sci ch2-bloch" color={gold} x={548} y={14} dir="right" r={16} arrowClass="arrow arrow-sci" />
      <Bloch class="bloch-sw ch2-bloch" color={cyan} x={548} y={44} dir="up" r={16} arrowClass="arrow arrow-sw" />
      <Bloch class="bloch-lead ch2-bloch" color={sand} x={548} y={74} dir="up" r={16} arrowClass="arrow arrow-lead" />
      <text class="ch2-state" x="580" y="38" font-size="13" fill="#f2f4f8">{c.ch2.state}</text>
      <text class="ch2-state" x="580" y="56" font-size="10" fill="#c5c9d3">{c.ch2.order}</text>
    </svg>
    <svg viewBox="0 0 840 250" preserveAspectRatio="xMidYMid meet" role="img" aria-label="A classical grid of compute tiles lighting in waves over a sparse matrix. No new quantum gates.">
      <g opacity="0.55" class="matrix"></g>
      <g class="tiles"></g>
    </svg>
  </div>
  <p class="caption"><em>{c.ch2.caption}</em></p>
</section>

<div class="divider" aria-hidden="true"></div>

<section class="chapter" id="ch3">
  <p class="kicker">{c.ch3.kicker}</p>
  <h2>{c.ch3.title}</h2>
  <p class="sub"><span class="math">{c.ch3.sub}</span></p>
  <div class="stage">
    <svg viewBox="0 0 840 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label="A CNOT from science onto software takes the incoming state to the GHZ state ket 000 plus ket 111 over square root 2, in order science, software, leadership. The software ket-0 arrow shrinks at the CNOT; science and leadership arrows stay at the centre.">
      <defs>
        <radialGradient id="aura-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={cyan} stop-opacity="0.35"></stop>
          <stop offset="55%" stop-color={gold} stop-opacity="0.18"></stop>
          <stop offset="100%" stop-color={gold} stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <text x="6" y="52" font-size="15" fill={gold}>|science⟩</text>
      <text x="6" y="144" font-size="15" fill={cyan}>|software⟩</text>
      <text x="6" y="254" font-size="15" fill={sand}>|leadership⟩</text>

      <line class="ch3-gold wire-glow-gold" x1="160" y1="48" x2="600" y2="48"></line>
      <line class="ch3-cyan wire-glow-cyan" x1="160" y1="140" x2="600" y2="140"></line>
      <line class="ch3-sand wire-glow-sand" x1="160" y1="250" x2="600" y2="250"></line>
      <line class="ch3-gold wire-gold" x1="160" y1="48" x2="600" y2="48" stroke-width="2.4"></line>
      <line class="ch3-cyan wire-cyan" x1="160" y1="140" x2="600" y2="140" stroke-width="2.4"></line>
      <line class="ch3-sand wire-sand" x1="160" y1="250" x2="600" y2="250" stroke-width="2.4"></line>

      <Bloch class="bloch-sci ch3-bloch" color={gold} x={240} y={48} dir="right" r={22} arrowClass="arrow arrow-sci" />
      <Bloch class="bloch-sw ch3-bloch" color={cyan} x={240} y={140} dir="up" r={22} arrowClass="arrow arrow-sw" />
      <Bloch class="bloch-lead ch3-bloch" color={sand} x={240} y={250} dir="up" r={22} arrowClass="arrow arrow-lead" />

      <g class="ch3-cnot">
        <line x1="400" y1="48" x2="400" y2="140" stroke={gold} stroke-width="1.6"></line>
        <circle cx="400" cy="48" r="6.5" fill={gold}></circle>
        <circle cx="400" cy="140" r="13" fill="none" stroke={cyan} stroke-width="2"></circle>
        <line x1="400" y1="128" x2="400" y2="152" stroke={cyan} stroke-width="2"></line>
        <line x1="388" y1="140" x2="412" y2="140" stroke={cyan} stroke-width="2"></line>
      </g>

      <ellipse class="ch3-aura" cx="520" cy="148" rx="120" ry="130" fill="url(#aura-grad)" stroke="none"></ellipse>

      <text class="ch3-bell" x="630" y="140" font-size="16" fill="#f2f4f8">{c.ch3.state}</text>
      <text class="ch3-bell ch3-order" x="630" y="160" font-size="11" fill="#c5c9d3">{c.ch3.order}</text>
    </svg>
  </div>
  <p class="caption ch3-caption"><em>{c.ch3.caption}</em></p>
</section>

<div class="divider" aria-hidden="true"></div>

<section class="chapter" id="ch4">
  <p class="kicker">{c.ch4.kicker}</p>
  <h2>{c.ch4.title}</h2>
  <p class="sub">{c.ch4.sub}</p>
    <p class="ch4-github">
      <a href="https://github.com/maliasadi" target="_blank" rel="noreferrer">GitHub</a>
    </p>
  <div class="stage ch4-stage">
    <svg class="ch4-wires" viewBox="0 0 840 64" preserveAspectRatio="xMidYMin meet" role="img" aria-label="The three wires continue in the GHZ state, with no new gates, behind the cards. All three Bloch arrows stay at the centre.">
      <text x="6" y="14" font-size="11" fill={gold}>|science⟩</text>
      <text x="6" y="32" font-size="11" fill={cyan}>|software⟩</text>
      <text x="6" y="50" font-size="11" fill={sand}>|leadership⟩</text>
      <line class="wire-glow-gold" x1="130" y1="10" x2="560" y2="10"></line>
      <line class="wire-glow-cyan" x1="130" y1="28" x2="560" y2="28"></line>
      <line class="wire-glow-sand" x1="130" y1="46" x2="560" y2="46"></line>
      <line class="wire-gold" x1="130" y1="10" x2="560" y2="10" stroke-width="2"></line>
      <line class="wire-cyan" x1="130" y1="28" x2="560" y2="28" stroke-width="2"></line>
      <line class="wire-sand" x1="130" y1="46" x2="560" y2="46" stroke-width="2"></line>
      <text class="ch4-state" x="572" y="28" font-size="13" fill="#f2f4f8">{c.ch4.state}</text>
      <text class="ch4-state" x="572" y="46" font-size="10" fill="#c5c9d3">{c.ch4.order}</text>
    </svg>
    <div class="cards">
      <article class="card" data-card="0">
        <h3><a href="https://pennylane.ai/" target="_blank" rel="noreferrer">PennyLane</a></h3>
        <p>{c.ch4.pennylane}</p>
        <div class="viz" aria-hidden="true">
          <svg viewBox="0 0 200 70">
            <text x="0" y="10" font-size="8" fill="#8b95a8">loss</text>
            <path d="M10 18 C 28 24, 42 28, 55 27 S 85 36, 110 38 S 140 46, 170 49 S 185 52, 190 52" fill="none" stroke={cyan} stroke-width="1.8"></path>
            <line x1="10" y1="60" x2="190" y2="60" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"></line>
            <line x1="10" y1="12" x2="10" y2="60" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"></line>
          </svg>
        </div>
      </article>
      <article class="card" data-card="1">
        <h3><a href="https://github.com/PennyLaneAI/catalyst" target="_blank" rel="noreferrer">Catalyst</a></h3>
        <p>{c.ch4.catalyst}</p>
        <div class="viz" aria-hidden="true">
          <svg class="pipeline-svg" viewBox="0 0 236 70">
            <g class="pipeline" font-size="8" font-family="IBM Plex Mono, monospace" text-anchor="middle" dominant-baseline="middle">
              <rect x="8" y="20" width="52" height="30" rx="3" fill="none" stroke={gold} stroke-width="1"></rect>
              <text x="34" y="35" font-size="8" fill={gold}>Python</text>
              <rect x="70" y="20" width="42" height="30" rx="3" fill="none" stroke={cyan} stroke-width="1"></rect>
              <text x="91" y="35" font-size="8" fill={cyan}>MLIR</text>
              <rect x="122" y="20" width="42" height="30" rx="3" fill="none" stroke={gold} stroke-width="1"></rect>
              <text x="143" y="35" font-size="8" fill={gold}>LLVM</text>
              <rect x="174" y="20" width="52" height="30" rx="3" fill="none" stroke={cyan} stroke-width="1"></rect>
              <text x="200" y="35" font-size="8" fill={cyan}>native</text>
              <path d="M60 35 H70 M112 35 H122 M164 35 H174" stroke="#8b95a8" stroke-width="1"></path>
            </g>
          </svg>
        </div>
      </article>
      <article class="card" data-card="2">
        <h3><a href="https://github.com/PennyLaneAI/pennylane-lightning" target="_blank" rel="noreferrer">Lightning</a></h3>
        <p>{c.ch4.lightning}</p>
        <div class="viz" aria-hidden="true">
          <svg viewBox="0 0 200 70">
            <text x="8" y="12" font-size="8" fill="#8b95a8">CPU</text>
            <text x="118" y="12" font-size="8" fill="#8b95a8">GPU</text>
            <g class="sv-cpu"></g>
            <g class="sv-gpu"></g>
          </svg>
        </div>
      </article>
    </div>
    <svg class="cluster-cables" viewBox="0 0 840 400" preserveAspectRatio="none" aria-hidden="true">
      <path class="cluster-cable" fill="none" stroke={gold} stroke-width="1.7" opacity="0.9"></path>
      <path class="cluster-cable" fill="none" stroke={cyan} stroke-width="1.7" opacity="0.9"></path>
      <path class="cluster-cable" fill="none" stroke={gold} stroke-width="1.7" opacity="0.9"></path>
    </svg>
    <ClusterRacks />
  </div>
  <p class="caption"><em>{c.ch4.caption}</em></p>
</section>

<div class="divider" aria-hidden="true"></div>

<section class="chapter" id="ch5">
  <p class="kicker">{c.ch5.kicker}</p>
  <h2>{c.ch5.title}</h2>
  <p class="sub">{c.ch5.sub}</p>
  <div class="stage">
    <div class="today-grid">
      <svg id="today-svg" viewBox="0 0 540 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label="After a four-qubit gate, a weighted entangled state on four wires: science, software, leadership and finance. The finance wire is a rising random-walk line that stays in its own lane. Ket 1000 is science, ket 0100 is software, ket 0010 is leadership, ket 0001 is finance.">
        <defs>
          <radialGradient id="aura-grad-5" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color={cyan} stop-opacity="0.35"></stop>
            <stop offset="55%" stop-color={gold} stop-opacity="0.18"></stop>
            <stop offset="100%" stop-color={gold} stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <text x="4" y="42" font-size="13" fill={gold}>|science⟩</text>
        <text x="4" y="102" font-size="13" fill={cyan}>|software⟩</text>
        <text x="4" y="162" font-size="13" fill={sand}>|leadership⟩</text>
        <text x="4" y="222" font-size="13" fill={green}>|finance⟩</text>
        <line class="t-gold wire-glow-gold" x1="126" y1="38" x2="292" y2="38"></line>
        <line class="t-cyan wire-glow-cyan" x1="126" y1="98" x2="292" y2="98"></line>
        <line class="t-sand wire-glow-sand" x1="126" y1="158" x2="292" y2="158"></line>
        <line class="t-gold wire-gold" x1="126" y1="38" x2="292" y2="38" stroke-width="2.4"></line>
        <line class="t-cyan wire-cyan" x1="126" y1="98" x2="292" y2="98" stroke-width="2.4"></line>
        <line class="t-sand wire-sand" x1="126" y1="158" x2="292" y2="158" stroke-width="2.4"></line>
        <ellipse class="t-aura" cx="210" cy="128" rx="110" ry="118" fill="url(#aura-grad-5)"></ellipse>
        <path class="t-finance-glow" d="" fill="none"></path>
        <path class="t-finance wire-green" d="" fill="none" stroke-width="2.4"></path>
        <g class="ch5-ugate">
          <line x1="300" y1="38" x2="300" y2="218" stroke="#f2f4f8" stroke-width="1.6"></line>
          <circle cx="300" cy="38" r="5" fill="none" stroke={gold} stroke-width="1.6"></circle>
          <circle cx="300" cy="98" r="5" fill="none" stroke={cyan} stroke-width="1.6"></circle>
          <circle cx="300" cy="158" r="5" fill="none" stroke={sand} stroke-width="1.6"></circle>
          <circle cx="300" cy="218" r="5" fill="none" stroke={green} stroke-width="1.6"></circle>
          <rect class="gate-box" x="288" y="116" width="24" height="24" rx="3" stroke={gold} stroke-width="1.4"></rect>
          <text x="300" y="128" font-size="13" fill={gold} text-anchor="middle" dominant-baseline="middle">U</text>
        </g>
        <text class="t-bell" x="328" y="118" font-size="11" fill="#f2f4f8">{c.ch5.state}</text>
        <text class="t-bell t-bell-sub" x="328" y="138" font-size="11" fill="#f2f4f8">{c.ch5.stateLine2}</text>
        <g class="ch5-blochs">
          <Bloch class="bloch-sci ch5-bloch" color={gold} x={250} y={38} dir="up" r={18} arrowClass="arrow arrow-sci" />
          <Bloch class="bloch-sw ch5-bloch" color={cyan} x={250} y={98} dir="up" r={18} arrowClass="arrow arrow-sw" />
          <Bloch class="bloch-lead ch5-bloch" color={sand} x={250} y={158} dir="up" r={18} arrowClass="arrow arrow-lead" />
          <Bloch class="bloch-fin ch5-bloch" color={green} x={250} y={218} dir="up" r={18} arrowClass="arrow arrow-fin" />
        </g>
      </svg>
      <div class="bars" id="amp-bars">
        <div class="bar-row" data-ket="1000" data-amp="0.447">
          <div class="ket">|1000⟩</div>
          <div class="track"><div class="fill" data-target="44.7"></div></div>
          <div class="val">0.447</div>
        </div>
