---
import type { WorkEntry } from '../data/work';

interface Props {
  entry: WorkEntry;
  heading?: 'h2' | 'h3';
}

const { entry, heading = 'h3' } = Astro.props;
const Title = heading;
---

<div class:list={['work-card', { 'is-featured': entry.featured, 'is-secondary': entry.secondary }]}>
  {
    (entry.featured || entry.latest) && (
      <div class="work-badges">
        {entry.featured && <span class="badge badge-featured">Featured</span>}
        {entry.latest && <span class="badge badge-latest">Latest research</span>}
      </div>
    )
  }
  <Title class="work-card-title">{entry.title}</Title>
  <p class="work-meta">{entry.meta}</p>
  <p class="work-summary">{entry.summary}</p>
  {
    entry.note && (
      <p class="work-note">
        {entry.note.before}
        <a href={entry.note.href} target="_blank" rel="noopener noreferrer">
          {entry.note.label}
        </a>
      </p>
    )
  }
  <p class="work-links">
    {
      entry.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label}
          {link.arrow && (
            <span class="ext" aria-hidden="true">
              ↗
            </span>
          )}
        </a>
      ))
    }
  </p>
</div>
