---
interface Props {
  note?: string;
}

const { note } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    {note && <p class="footer-note">{note}</p>}
    <p class="opinion">Writing on this site is my personal opinion.</p>
    <div class="footer-inner">
      <p style="margin: 0">© {year} Ali Asadi</p>
      <p style="margin: 0">
        <a href="https://x.com/quthreads" target="_blank" rel="noreferrer">X</a>
        <span aria-hidden="true"> · </span>
        <a href="/rss.xml">RSS</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-note {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>
