---
const path = Astro.url.pathname;
const items = [
  { href: '/blog/', label: 'Blog' },
  { href: '/talks/', label: 'Talks' },
];

function current(href: string) {
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4.2 21.2 12 2.8 19.8 21.2"></path>
        <circle cx="12" cy="14.6" r="2.65"></circle>
        <path d="M7.05 14.6h9.9"></path>
      </svg>
      Ali Asadi
    </a>
    <nav class="nav" aria-label="Primary">
      {
        items.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch color theme">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <circle cx="12" cy="12" r="3.4"></circle>
        <path d="M12 3.2v1.8M12 19v1.8M3.2 12h1.8M19 12h1.8M5.6 5.6l1.3 1.3M17.1 17.1l1.3 1.3M18.4 5.6l-1.3 1.3M6.9 17.1l-1.3 1.3"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');

  function resolvedTheme(): 'light' | 'dark' {
    const explicit = document.documentElement.getAttribute('data-theme');
    if (explicit === 'light' || explicit === 'dark') return explicit;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function syncLabel() {
    if (!button) return;
    const next = resolvedTheme() === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
  }

  syncLabel();

  button?.addEventListener('click', () => {
    const next = resolvedTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode */
    }
    syncLabel();
  });
</script>
